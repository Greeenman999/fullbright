{
  "schemaVersion": 1,
  "id": "${id}",
  "version": "${version}",
  "name": "${name}",
  "description": "This is a fabric mod that adds a fullbright feature to the game.",
  "authors": [
    "Greenman999"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/fullbright",
    "sources": "https://github.com/Greeenman999/fullbright"
  },
  "license": "GPL-3.0",
  "icon": "assets/fullbright/icon.png",
  "environment": "*",
  "entrypoints": {
    "client": [
      "de.greenman999.fullbright.FullbrightClient"
    ]
  },
  "mixins": [
    {
      "config": "fullbright.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.17.2",
    "minecraft": "${minecraft}",
    "fabric-api": "*"
  }
}